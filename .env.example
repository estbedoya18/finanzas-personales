# Credenciales de Gmail (OAuth refresh token)
# Cómo obtenerlas: ver sección "Configuración" del README
GMAIL_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu-client-secret
GMAIL_REFRESH_TOKEN=tu-refresh-token

# Credenciales de Google Sheets (service account)
# Pega aquí el JSON completo de la service account, en una sola línea
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}

# ID del Google Sheet (lo sacas de la URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
SHEET_ID=tu-sheet-id
